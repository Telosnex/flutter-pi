# The WPE WebKit SDK that the Telosnex runner builds against and that tpi
# installs on the Pi at /opt/telosnex/wpe. Published by
# Telosnex/flutter_inappwebview (flutter_inappwebview_linux/wpe_sdk).
# Change it together with wpeSdk in Telosnex's toolchain.lock.json.
WPE_SDK_TAG=wpe-sdk-da643195e9f98b5b
WPE_SDK_TARGET=debian-13-arm64
WPE_SDK_SHA256=4e26b585d67164883db49c1101fe5af563786b5ec2e3274ef338edcabe7029a4
WPE_SDK_PREFIX=/opt/telosnex/wpe
